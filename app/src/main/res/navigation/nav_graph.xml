<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.tenantmanagementsystemgroupa.ui.tenants.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.tenantmanagementsystemgroupa.ui.tenants.AddTenantFragment"
        android:label="@string/nav_add_tenant"
        tools:layout="@layout/fragment_add_tenant">
        <action
            android:id="@+id/action_addTenantFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:popUpTo="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/viewTenantsFragment"
        android:name="com.example.tenantmanagementsystemgroupa.ui.tenants.ViewTenantsFragment"
        android:label="@string/nav_view_tenants"
        tools:layout="@layout/fragment_view_tenants">
        <action
            android:id="@+id/action_viewTenantsFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment" />
    </fragment>

</navigation>
